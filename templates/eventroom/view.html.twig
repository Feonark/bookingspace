{% extends 'base.html.twig' %}

{% block title %}Détails de la salle
	{{ eventRoom.name }}
{% endblock %}

{% block stylesheets %}{% endblock %}

{% block body %}
	<div
		class="max-w-5xl mx-auto p-6">

		{# MESSAGE FLASH #}
		{% for label, messages in app.flashes %}
			<div class="mb-4 p-3 rounded {{ label == 'success' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' }}">
				{% for message in messages %}
					{{ message }}
				{% endfor %}
			</div>
		{% endfor %}

		<a href="{{ url('eventrooms_list') }}" class="inline-block text-black py-2 px-4 rounded-xl hover:bg-gray-200 cursor-pointer mb-8">← Retour à la liste des salles</a>

		{# CONTENU DE LA PAGE #}
		<div
			class="flex flex-row gap-12">

			{# PARTIE GAUCHE #}
			<div class="w-3/5">
				<div class="relative p-24 rounded-xl text-center text-white bg-cover bg-center" style="background-image: url('{{ asset('uploads/images/' ~ eventRoom.image) }}');">

					<div class="absolute inset-0 bg-black/40 rounded-xl"></div>

					<div class="relative z-10 flex flex-col gap-4">
						<h1 class="text-3xl font-semibold">Salle
							{{ eventRoom.name }}</h1>
						<p class="text-gray-100">{{ eventRoom.capacity }}
							places •
							{{ eventRoom.location }}</p>
					</div>
				</div>


				{% if eventRoom.description %}
					<p class="mt-6 mb-12 text-lg">
						{{ eventRoom.description }}</p>
				{% endif %}

				<h2 class="text-xl font-semibold mb-2">Logiciels disponibles</h2>
				<ul class="list-disc list-inside mb-4">
					{% for software in eventRoom.softwares %}
						<li>{{ software.name }}</li>
					{% else %}
						<li>Aucun logiciel disponible.</li>
					{% endfor %}
				</ul>

				<h2 class="text-xl font-semibold mb-2">Équipements disponibles</h2>
				<ul class="list-disc list-inside mb-4">
					{% for equipment in eventRoom.equipments %}
						<li>{{ equipment.name }}</li>
					{% else %}
						<li>Aucun équipement disponible.</li>
					{% endfor %}
				</ul>

				<h2 class="text-xl font-semibold mb-2">Critères ergonomiques</h2>
				<ul class="list-disc list-inside mb-8">
					{% for criterion in eventRoom.ergonomicCriterias %}
						<li>{{ criterion.name }}</li>
					{% else %}
						<li>Aucun critère ergonomique renseigné.</li>
					{% endfor %}
				</ul>
			</div>

			{# PARTIE DROITE #}
			<div class="w-2/5 flex flex-col gap-4">
				<div data-live-ignore class="rounded w-full overflow-auto">
					{% include 'booking/calendar.html.twig' %}
				</div>

				{% if app.user %}
					{% if 'ROLE_ADMIN' in app.user.roles %}
						<div class="p-4 bg-red-100 text-red-800 rounded mb-4">
							Les administrateurs ne peuvent pas faire de réservation.
						</div>
					{% endif %}
				{% endif %}

				{% if not is_granted('ROLE_ADMIN') %}
					<div class="p-4 bg-gray-200 rounded-xl">
						<h2 class="text-2xl font-semibold mb-4 text-center">Vous souhaitez réserver ?</h2>

						<div class="flex flex-row w-full gap-4">
							{{ form_start(bookingForm, {
    'action': path('eventroom_book', {'eventRoom': eventRoom.id}),
    'method': 'POST',
    'attr': {'class': 'w-full'}
}) }}


							<div class="flex flex-row gap-4 w-full">

								<div class="flex flex-col mb-4 w-1/2">
									{{ form_label(bookingForm.dateStart, null, {'label_attr': {'class': 'mb-1 text-gray-700 font-medium'}}) }}
									{{ form_widget(bookingForm.dateStart, {'attr': {'class': 'px-3 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-gray-100 transition w-full'}}) }}
									{{ form_errors(bookingForm.dateStart) }}
								</div>

								<div class="flex flex-col mb-4 w-1/2">
									{{ form_label(bookingForm.dateEnd, null, {'label_attr': {'class': 'mb-1 text-gray-700 font-medium'}}) }}
									{{ form_widget(bookingForm.dateEnd, {'attr': {'class': 'px-3 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-gray-100 transition w-full'}}) }}
									{{ form_errors(bookingForm.dateEnd) }}
								</div>

							</div>

							<div class="flex items-end">
								{{ form_widget(bookingForm.book, {'attr': {'class': 'w-full bg-blue-600 text-white py-2 px-4 rounded-xl hover:bg-blue-700 cursor-pointer'}}) }}
							</div>

							{{ form_end(bookingForm) }}

						</div>
					</div>
				{% endif %}

			</div>
		</div>
	{% endblock %}
