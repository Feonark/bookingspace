{% extends 'base.html.twig' %}

{% block title %}Recherche de salles
{% endblock %}

{% block body %}

	{% for label, messages in app.flashes %}
		<div class="alert alert-{{ label }}">
			{% for message in messages %}
				{{ message }}
			{% endfor %}
		</div>
	{% endfor %}
	<div class="p-4">
		<h1 class="p-24 text-center text-3xl font-semibold">Rechercher une salle</h1>
		<twig:EventRoomSearch/>
	</div>

{% endblock %}
