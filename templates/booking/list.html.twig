{% extends 'base.html.twig' %}

{% block stylesheets %}
	{{ parent() }}
	{{ encore_entry_link_tags('calendar') }}
{% endblock %}

{% block body %}
	{% for label, messages in app.flashes %}
		<div class="alert alert-{{ label }}">
			{% for message in messages %}
				{{ message }}
			{% endfor %}
		</div>
	{% endfor %}

	<h1>Voici la liste de vos réservations,
		{{ app.user.username }}</h1>
	<ul>
		<div class="flex flex-row">
			{% for booking in bookings %}
				<div>
					<div>Vous avez réservé la salle
						{{ booking.eventRoom.name }}
						du
						{{ booking.dateStart|date("m/d/Y") }}
						au
						{{ booking.dateEnd|date("m/d/Y") }}</div>
					<div>Statut de la réservation :
						{{ booking.bookingStatus.value }}

						{% if (booking.bookingStatus.value != 'cancelled')%}
							<a href="{{ path('booking_cancel', {'id': booking.id }) }}" class="bg-white">Annuler la réservation</a>
						{% endif %}
						{% if (booking.bookingStatus.value != 'confirmed' and booking.bookingStatus.value != 'cancelled')%}
							<div>
								<a href="{{ path('booking_edit', {'eventRoom': booking.eventRoom.id }) }}" class="bg-white">Modifier la réservation</a>
							</div>
						{% endif %}
					</div>
				</div>
			{% endfor %}
		</div>
	</ul>

{% endblock %}
