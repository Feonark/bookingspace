{% extends 'base.html.twig' %}

{% block title %}Détails de la salle
	{{ eventRoom.name }}
{% endblock %}

{% block body %}

	{% for label, messages in app.flashes %}
		<div class="alert alert-{{ label }}">
			{% for message in messages %}
				{{ message }}
			{% endfor %}
		</div>
	{% endfor %}

	{{ form_start(bookingForm) }}
	{{ form_row(bookingForm.dateStart) }}
	{{ form_errors(bookingForm.dateStart) }}
	{{ form_row(bookingForm.dateEnd) }}
	{{ form_errors(bookingForm.dateEnd) }}
	{{ form_row(bookingForm.book) }}
	{{ form_end(bookingForm) }}
{{ form_errors(bookingForm) }}
    {{ form_rest(bookingForm) }}

{% endblock %}
