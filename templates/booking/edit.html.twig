{% extends 'base.html.twig' %}

{% block title %}Détails de la salle
	{{ eventRoom.name }}
{% endblock %}

{% block body %}
	<div class="max-w-md mx-auto mt-10 p-6 bg-gray-100 rounded-xl shadow-md flex flex-col gap-8">
		<div data-live-ignore class="rounded w-full overflow-auto">
			{% include 'booking/calendar.html.twig' %}
		</div>

		<h1 class="text-2xl font-semibold text-center mb-6">Modifier la réservation</h1>

		{% for label, messages in app.flashes %}
			<div class="mb-4 p-3 rounded {{ label == 'success' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' }}">
				{% for message in messages %}
					{{ message }}
				{% endfor %}
			</div>
		{% endfor %}

		{{ form_start(bookingForm) }}

		<div class="mb-4">
			{{ form_label(bookingForm.dateStart, null, {'label_attr': {'class': 'block mb-1 font-medium text-gray-700'}}) }}
			{{ form_widget(bookingForm.dateStart, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
			{{ form_errors(bookingForm.dateStart) }}
		</div>

		<div class="mb-4">
			{{ form_label(bookingForm.dateEnd, null, {'label_attr': {'class': 'block mb-1 font-medium text-gray-700'}}) }}
			{{ form_widget(bookingForm.dateEnd, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
			{{ form_errors(bookingForm.dateEnd) }}
		</div>

		<div class="mt-6">
			{{ form_widget(bookingForm.book, {'attr': {'class': 'w-full bg-blue-600 text-white font-semibold py-2 px-4 rounded-lg hover:bg-blue-700 transition'}}) }}
		</div>

		{{ form_end(bookingForm) }}
	</div>
{% endblock %}
