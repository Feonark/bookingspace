{% extends '@EasyAdmin/layout.html.twig' %}

{% block header_custom_menu_wrapper %}
    <div style="position: relative; margin-right: 20px;">
        <a href="{{ path('admin_notification_index') }}" style="color: inherit; text-decoration: none;">
            <i class="fas fa-bell" style="font-size: 20px;"></i>
            {% if unreadNotificationsCount > 0 %}
                <span style="
                    position: absolute;
                    top: -8px;
                    right: -8px;
                    background: red;
                    color: white;
                    border-radius: 50%;
                    font-size: 12px;
                    padding: 2px 6px;
                ">
                    {{ unreadNotificationsCount }}
                </span>
            {% endif %}
        </a>
    </div>
    {{ parent() }}
{% endblock %}

{% block content %}
    <h1>Bienvenue sur le Dashboard </h1>

    {{ parent() }}

{% endblock %}
