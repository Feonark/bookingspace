<div class="sticky top-0 z-50">
	{% if app.user %}
		<div class="flex justify-center bg-blue-600 text-white p-1 gap-2 text-sm">Vous naviguez en tant que
			{{ app.user.username }}
			<form action="{{ path('app_logout') }}" method="post" class="inline">
				<button type="submit" class="font-semibold text-sm cursor-pointer bg-transparent border-none p-0 underline text-white hover:text-gray-200">
					Se déconnecter
				</button>
			</form>
		</div>
	{% endif %}

	<div class="flex flex-row py-2 justify-between bg-gray-200 px-12">
		<div class="flex font-bold items-center justify-center text-center">
			<a href="{{ path('eventrooms_list') }}" class="">BookingSpace</a>
		</div>
		<div class="flex flex-row gap-2">
			{% if app.user %}
				{% if is_granted('ROLE_ADMIN') %}
					<a href="{{ path('admin') }}" class="flex flex-row bg-gray-200 text-black py-2 px-4 rounded-xl hover:bg-gray-300 cursor-pointer gap-2">
						<span>{{ ux_icon('eos-icons:admin-outlined', { class: 'w-6 h-6' }) }}</span>
						Dashboard
					</a>
				{% else %}
					<a href="{{ path('bookings') }}" class="flex flex-row bg-gray-200 text-black py-2 px-4 rounded-xl hover:bg-gray-300 cursor-pointer gap-2">
						<span>{{ ux_icon('mynaui:calendar', { class: 'w-6 h-6' }) }}</span>
						Réservations
					</a>
				{% endif %}

			{% else %}
				<a href="{{ path('app_login') }}" class="bg-blue-600 text-white py-2 px-4 rounded-xl hover:bg-blue-700 cursor-pointer">
					Se connecter
				</a>
			{% endif %}

		</div>
	</div>
</div>
