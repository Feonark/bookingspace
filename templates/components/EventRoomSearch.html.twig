<div{{attributes}}
	class="flex flex-row max-w-5xl mx-auto p-6 gap-12">
	<!-- component HTML -->

	<div
		class="w-1/3 max-w-96 flex flex-col gap-4">

		{# FILTRER PAR NOM #}
		<div class="relative w-full max-w-sm">
			<input type="text" data-model="query" placeholder="Tapez un mot-clé..." class="w-full h-10 p-4 rounded-full text-sm border border-gray-300 bg-gray-200 focus:outline-none"/>
			<div class="absolute inset-y-0 right-3 flex items-center pointer-events-none">
				<svg class="w-5 h-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M10 18a8 8 0 100-16 8 8 0 000 16z"/>
				</svg>
			</div>
		</div>

		{# FILTRER PAR DISPONIBILITES #}
		<div class="p-4 rounded-xl bg-gray-200 flex flex-col gap-4">
			<h3 class="flex items-center font-semibold text-xl mb-2 gap-2">
				<span>{{ ux_icon('flowbite:calendar-month-outline', { class: 'w-6 h-6' }) }}</span>Filtrer par disponibilité</h3>

			<div class="flex flex-row w-full gap-4">
				<label class="flex flex-col text-sm text-gray-700 w-full">
					Date de début :
					<input type="date" data-model="dateStart" class="mt-1 px-3 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-gray-100 transition"/>
				</label>

				<label class="flex flex-col text-sm text-gray-700 w-full">
					Date de fin :
					<input type="date" data-model="dateEnd" class="mt-1 px-3 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-gray-100 transition"/>
				</label>
			</div>
		</div>

		{# FILTRER PAR CAPACITÉ #}
		<div class="p-4 rounded-xl bg-gray-200 flex flex-col gap-2">
			<h3 class="flex items-center font-semibold text-xl mb-2 gap-2">
				<span>{{ ux_icon('lucide:users', { class: 'w-6 h-6' }) }}</span>Filtrer par capacité</h3>
			<label class="flex flex-col">
				<input type="number" min="0" placeholder="Capacité voulue" data-model="capacity" class="px-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm bg-gray-100 transition"/>
			</label>
		</div>

		{# FILTRER PAR EQUIPEMENT #}
		<div class="p-4 rounded-xl bg-gray-200 flex flex-col gap-2">
			<h3 class="flex items-center font-semibold mb-2 text-xl gap-2">
				<span>{{ ux_icon('flowbite:chalkboard-outline', { class: 'w-6 h-6' }) }}</span>Filtrer par équipement
			</h3>
			<div class="">
				{% for equipment in this.equipments %}
					<label class="cursor-pointer">
						<input type="checkbox" value="{{ equipment.id }}" data-model="selected_equipments" class="sr-only peer"/>
						<div class="px-2 py-1 rounded-xl border border-gray-600 text-black text-sm transition
								hover:bg-gray-300
								peer-checked:bg-blue-700 peer-checked:text-white peer-checked:border-blue-700
								peer-checked:hover:bg-blue-700">
							{{ equipment.name }}
						</div>
					</label>
				{% endfor %}
			</div>
		</div>

		{# FILTRER PAR ERGONOMICCRITERIA #}
		<div class="p-4 rounded-xl bg-gray-200 flex flex-col gap-2">
			<h3 class="flex items-center font-semibold mb-2 text-xl gap-2">
				<span>{{ ux_icon('flowbite:face-laugh-outline', { class: 'w-6 h-6' }) }}</span>Filtrer par crit. ergo.</h3>
			<div class="">
				{% for ergonomicCriteria in this.ergonomicCriterias %}
					<label class="cursor-pointer">
						<input type="checkbox" value="{{ ergonomicCriteria.id }}" data-model="selected_ergonomic_criterias" class="sr-only peer"/>
						<div class="px-2 py-1 rounded-xl border border-gray-600 text-black text-sm transition
								hover:bg-gray-300
								peer-checked:bg-blue-700 peer-checked:text-white peer-checked:border-blue-700
								peer-checked:hover:bg-blue-700">
							{{ ergonomicCriteria.name }}
						</div>
					</label>
				{% endfor %}
			</div>
		</div>

		{# FILTRER PAR SOFTWARE #}
		<div class="p-4 rounded-xl bg-gray-200 flex flex-col gap-2">
			<h3 class="flex items-center font-semibold mb-2 text-xl gap-2">
				<span>{{ ux_icon('flowbite:windows-solid', { class: 'w-6 h-6' }) }}</span>Filtrer par logiciel</h3>
			<div class="">
				{% for software in this.softwares %}
					<label class="cursor-pointer">
						<input type="checkbox" value="{{ software.id }}" data-model="selected_softwares" class="sr-only peer"/>
						<div class="px-2 py-1 rounded-xl border border-gray-600 text-black text-sm transition
								hover:bg-gray-300
								peer-checked:bg-blue-700 peer-checked:text-white peer-checked:border-blue-700
								peer-checked:hover:bg-blue-700">
							{{ software.name }}
						</div>
					</label>
				{% endfor %}
			</div>
		</div>

	</div>

	{# AFFICHAGE DES SALLES #}
	{% set eventRooms = this.eventRooms %}
	{% if eventRooms|length > 0 %}
		<div class="w-2/3 flex flex-col gap-4">
			<p class="">{{ eventRooms|length }}
				{{ eventRooms|length > 1 ? "résultats" : "résultat"}}</p>
			<p class="text-sm text-gray-600 italic">
				Filtres appliqués :
				{% set hasFilter = false %}
				{% if query %}
					{% set hasFilter = true %}<span class="font-medium">Mot-clé :</span>
					"{{ query }}",
				{% endif %}
				{% if dateStart %}
					{% set hasFilter = true %}<span class="font-medium">Début :</span>
					{{ dateStart|date('d/m/Y') }},
				{% endif %}
				{% if dateEnd %}
					{% set hasFilter = true %}<span class="font-medium">Fin :</span>
					{{ dateEnd|date('d/m/Y') }},
				{% endif %}
				{% if capacity %}
					{% set hasFilter = true %}<span class="font-medium">Capacité min. :</span>
					{{ capacity }},
				{% endif %}
				{% if selected_equipments is not empty %}
					{% set hasFilter = true %}<span class="font-medium">Équipements :</span>
					{{ selected_equipments|length }},
				{% endif %}
				{% if selected_ergonomic_criterias is not empty %}
					{% set hasFilter = true %}<span class="font-medium">Critères ergo :</span>
					{{ selected_ergonomic_criterias|length }},
				{% endif %}
				{% if selected_softwares is not empty %}
					{% set hasFilter = true %}<span class="font-medium">Logiciels :</span>
					{{ selected_softwares|length }},
				{% endif %}

				{% if not hasFilter %}Aucun filtre appliqué.
				{% endif %}
			</p>

			<div class="grid grid-cols-2 gap-4">
				{% for eventRoom in eventRooms %}
					<div class="flex flex-col bg-gray-200 p-4 rounded-xl gap-4">
						<div class="flex flex-col gap-4">
							<p class="font-semibold">
								Salle
								{{ eventRoom.name }}
							</p>
							<div class="flex flex-rowg gap-1">
								<span title="Capacité maximum" class="px-2 py-[2px] bg-gray-500 text-white rounded-full flex items-center gap-1 w-fit">{{ ux_icon('lucide:users', { class: 'w-4 h-4' }) }}{{ eventRoom.capacity }}</span>
								<span title="Équipements" class="px-2 py-[2px] bg-gray-500 text-white rounded-full flex items-center gap-1 w-fit">{{ ux_icon('flowbite:chalkboard-outline', { class: 'w-4 h-4' }) }}{{ eventRoom.equipments|length }}</span>
								<span title="Critères ergonomiques" class="px-2 py-[2px] bg-gray-500 text-white rounded-full flex items-center gap-1 w-fit">{{ ux_icon('flowbite:face-laugh-outline', { class: 'w-4 h-4' }) }}{{ eventRoom.ergonomicCriterias|length }}</span>
								<span title="Logiciels" class="px-2 py-[2px] bg-gray-500 text-white rounded-full flex items-center gap-1 w-fit">{{ ux_icon('flowbite:windows-solid', { class: 'w-4 h-4' }) }}{{ eventRoom.softwares|length }}</span>
							</div>
						</div>
						<a href="{{ path('eventroom', {'eventRoom': eventRoom.id })}}" class="bg-blue-600 text-white text-center py-2 px-4 rounded-xl hover:bg-blue-700 cursor-pointer">Consulter ou réserver</a>
					</div>
				{% endfor %}
			</div>
		</div>
	{% else %}
		<p>Aucune salle trouvée</p>
	{% endif %}
</div>
